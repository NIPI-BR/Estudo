<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <!-- Velocidade -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wpm_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/wpm_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:text="" />

        <com.google.android.material.slider.Slider
            android:id="@+id/wpm_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="60"
            android:valueTo="1000"
            android:stepSize="10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/wpm_help"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Retrocesso do toque duplo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rewind_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rewind_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:text="" />

        <com.google.android.material.slider.Slider
            android:id="@+id/rewind_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="5"
            android:valueTo="100"
            android:stepSize="5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/rewind_help"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Tamanho da palavra -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/font_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:text="" />

        <com.google.android.material.slider.Slider
            android:id="@+id/font_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="24"
            android:valueTo="140"
            android:stepSize="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/font_help"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Pausa na pontuação -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/punctuation_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/punctuation_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/punctuation_help"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
